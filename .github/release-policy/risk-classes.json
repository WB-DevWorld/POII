        "apps/web/src/app/sign-in/**",
        "apps/web/src/app/login/**",
        "apps/web/src/app/tokens/**",
        "apps/web/src/app/account/**",
        "apps/web/src/lib/session*",
        "apps/web/src/lib/auth*",
        "apps/web/src/lib/token*",
        "apps/web/src/middleware.ts",
        "apps/web/src/proxy.ts",
        "apps/web/src/**/*identity*",
        "apps/web/src/**/*session*",
        "apps/web/src/**/*token*",
        "apps/web/src/**/*auth*",
        "apps/web/src/**/*signin*",
        "apps/web/src/**/*sign-in*",
        "apps/web/src/**/*signout*",
