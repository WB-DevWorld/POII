{
  "name": "poii",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "contracts": "pnpm --filter @poii/contracts build",
    "typecheck": "pnpm run contracts && pnpm -r typecheck",
    "test": "pnpm run contracts && pnpm -r test",
    "lint": "pnpm run contracts && pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "policy:check": "node --test \".github/release-policy/*.test.mjs\" \"infra/scripts/*.test.mjs\" && node .github/release-policy/check-coverage.mjs"
  }
}
