# LOCAL ONLY. Copy to .env and fill in; never commit .env.
# PostgreSQL started by `docker compose up -d postgres`.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgres://poii:change-me-locally@localhost:5433/poii
TEST_DATABASE_URL=postgres://poii:change-me-locally@localhost:5433/poii

# Identity adapter: local-owner signs every request in as the single owner (development and standalone).
POII_IDENTITY_ADAPTER=local-owner
POII_OWNER_DISPLAY_NAME=Owner

# Object storage for originals and backups: local directory (gitignored) or S3-compatible later.
POII_STORAGE_ADAPTER=local
POII_STORAGE_LOCAL_DIR=.poii-storage

# AI execution stays off until providers are configured. Caps are USD per provider per calendar month.
POII_AI_ENABLED=false
POII_AI_MONTHLY_CAP_USD_ANTHROPIC=20
POII_AI_MONTHLY_CAP_USD_OPENAI=20
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# #13 AI: optional settings (defaults shown). A provider is used only when POII_AI_ENABLED=true and its key is set.
# POII_AI_PROVIDER_DEFAULT=anthropic
# POII_AI_ANTHROPIC_MODEL=claude-opus-5-5
# POII_AI_OPENAI_MODEL=gpt-6.1-sol
# POII_AI_LOG_REQUEST_TEXT=false
# POII_AI_PREVIEW_TTL_SECONDS=900
# POII_AI_MAX_INPUT_CHARS=100000
# POII_AI_MAX_OUTPUT_TOKENS=8000
# POII_AI_TIMEOUT_MS=600000
# end #13 AI

# Web
API_INTERNAL_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Agent bot identity (GitHub App "wbdevworld-poii-agent"): agents commit and open PRs as the bot.
# See docs/runbooks/owner-setup.md section 2 and scripts/agent-token.mjs. The key file lives outside the repo.
# POII_AGENT_APP_ID=
# POII_AGENT_INSTALLATION_ID=
# POII_AGENT_PRIVATE_KEY_PATH=

# #16 ops: backup runner (`pnpm --filter @poii/api backup:run`; docs/runbooks/backup-and-restore-drill.md).
# local writes to a directory (artifacts/ is gitignored); s3 writes to an S3-compatible bucket (path-style).
POII_BACKUP_TARGET=local
POII_BACKUP_LOCAL_DIR=artifacts/backups
POII_BACKUP_KEEP=30
# POII_BACKUP_S3_ENDPOINT=https://objects.example.test
# POII_BACKUP_S3_BUCKET=
# POII_BACKUP_S3_ACCESS_KEY=
# POII_BACKUP_S3_SECRET_KEY=
# POII_BACKUP_S3_REGION=us-east-1
# POII_BACKUP_S3_PREFIX=poii/
# POII_BACKUP_S3_TIMEOUT_MS=   (default: 600000 for uploads, 60000 otherwise)
# BUILD_TIME is set by the image build and shown by GET /health/version.
# #14 auth and tokens (ADR-0009). local-signin = password sign-in backed by Better Auth; local-owner stays the default.
# POII_IDENTITY_ADAPTER=local-signin
# Required for local-signin: Better Auth signs the session cookie with it. At least 32 random characters,
# for example the output of `openssl rand -base64 48`. Changing it signs everyone out.
# POII_SESSION_SECRET=
# Creates the owner's sign-in user (login POII_OWNER_LOGIN) at API start while no sign-in user exists; 12 to 128
# characters. Ignored (with a warning) once the user exists: remove it after the first start.
# POII_OWNER_BOOTSTRAP_PASSWORD=
# 3 to 30 letters, digits, _ or . (stored in lower case). Fixed once the owner user exists.
# POII_OWNER_LOGIN=owner
# Absolute session lifetime in hours (never extended by use).
# POII_SESSION_TTL_HOURS=336
# The API's own origin, as Better Auth's baseURL (its endpoints live under <origin>/v1/auth).
# POII_API_BASE_URL=http://localhost:3001
# true only when the API is reachable solely through the web app (or another trusted proxy): Better Auth's rate
# limiter then keys on the right-most X-Forwarded-For entry instead of the TCP peer address.
# POII_TRUST_PROXY=false
# Never set BETTER_AUTH_TELEMETRY: the API refuses to start under local-signin when it is enabled.
# #17 AccessLobby OIDC (ADR-0011): "Sign in with AccessLobby" and explicit account linking on top of local-signin.
# Off unless the issuer is set. Registration request: docs/runbooks/accesslobby-client-registration.md.
# POII_ACCESSLOBBY_ISSUER=https://<AccessLobby IAM host>/realms/accesslobby-first-party
# POII_ACCESSLOBBY_CLIENT_ID=poii-local
# The AccessLobby API that answers GET /v1/me (person.id).
# POII_ACCESSLOBBY_API_URL=https://<AccessLobby API host>
# Only for a confidential client (client_secret_basic); unset = public client with PKCE (the default profile).
# POII_ACCESSLOBBY_CLIENT_SECRET=
# Optional (defaults shown): access-token audience, registered URIs on the web origin, timeout for calls to AccessLobby.
# POII_ACCESSLOBBY_API_AUDIENCE=accesslobby-api
# POII_ACCESSLOBBY_REDIRECT_URI=http://localhost:3000/signin/accesslobby/callback
# POII_ACCESSLOBBY_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signin/accesslobby/signed-out
# POII_ACCESSLOBBY_TIMEOUT_MS=5000
