# LOCAL ONLY. Copy to .env and fill in; never commit .env.
# PostgreSQL started by `docker compose up -d postgres`.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgres://poii:change-me-locally@localhost:5433/poii
TEST_DATABASE_URL=postgres://poii:change-me-locally@localhost:5433/poii

# Identity adapter: local-owner signs every request in as the single owner (development and standalone).
POII_IDENTITY_ADAPTER=local-owner
POII_OWNER_DISPLAY_NAME=Owner

# Object storage for originals and backups: local directory (gitignored) or S3-compatible later.
POII_STORAGE_ADAPTER=local
POII_STORAGE_LOCAL_DIR=.poii-storage

# AI execution stays off until providers are configured. Caps are USD per provider per calendar month.
POII_AI_ENABLED=false
POII_AI_MONTHLY_CAP_USD_ANTHROPIC=20
POII_AI_MONTHLY_CAP_USD_OPENAI=20
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# #13 AI: optional settings (defaults shown). A provider is used only when POII_AI_ENABLED=true and its key is set.
# POII_AI_PROVIDER_DEFAULT=anthropic
# POII_AI_ANTHROPIC_MODEL=claude-opus-5-5
# POII_AI_OPENAI_MODEL=gpt-6.1-sol
# POII_AI_LOG_REQUEST_TEXT=false
# POII_AI_PREVIEW_TTL_SECONDS=900
# POII_AI_MAX_INPUT_CHARS=100000
# POII_AI_MAX_OUTPUT_TOKENS=8000
# POII_AI_TIMEOUT_MS=600000
# end #13 AI

# Web
API_INTERNAL_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Agent bot identity (GitHub App "wbdevworld-poii-agent"): agents commit and open PRs as the bot.
# See docs/runbooks/owner-setup.md section 2 and scripts/agent-token.mjs. The key file lives outside the repo.
# POII_AGENT_APP_ID=
# POII_AGENT_INSTALLATION_ID=
# POII_AGENT_PRIVATE_KEY_PATH=
