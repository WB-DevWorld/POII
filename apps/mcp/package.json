{
  "name": "@poii/mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Read-only MCP server for POII (stdio). Wraps the POII HTTP API with an owner token of scope read.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "poii-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@poii/contracts": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
